{
  "name": "cloud-ide-extension-test",
  "publisher": "Revature",
  "repository": "https://github.com/Revature/cloud-ide-extension",
  "displayName": "Cloud IDE Extension Test",
  "description": "Management tool for the Revature Cloud IDE",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "viewsWelcome": [
    {
      "view": "cloudIdeWebview",
      "contents": "Loading Cloud IDE Hub...",
      "when": "!cloudIdeInitialized"
    }
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Cloud IDE Test Runner",
      "properties": {
        "cloudIde.testRunner.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh test results when files change"
        },
        "cloudIde.testRunner.showFullOutput": {
          "type": "boolean", 
          "default": false,
          "description": "Show full test output in results"
        },
        "cloudIde.testRunner.timeout": {
          "type": "number",
          "default": 300000,
          "description": "Test execution timeout in milliseconds"
        }
      }
    },
    "commands": [
      {
        "command": "cloud-ide-extension.showInfo",
        "title": "Show Info"
      },
      {
        "command": "cloud-ide-extension.openDevServer",
        "title": "Open Dev Server"
      },
      {
        "command": "cloud-ide-extension.openRightPanel",
        "title": "Open Cloud IDE Panel"
      },
      {
        "command": "cloud-ide-extension.detectTests",
        "title": "Detect Tests",
        "icon": "$(search)"
      },
      {
        "command": "cloud-ide-extension.runAllTests",
        "title": "Run All Tests",
        "icon": "$(play)"
      },
      {
        "command": "cloud-ide-extension.runSingleTest",
        "title": "Run Single Test",
        "icon": "$(play)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cloud-ide-explorer",
          "title": "Cloud IDE",
          "icon": "resources/cloud.svg"
        }
      ]
    },
    "views": {
      "cloud-ide-explorer": [
        {
          "type": "webview",
          "icon": "resources/cloud.svg",
          "id": "cloudIdeWebview",
          "name": "Cloud IDE Hub"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "cloud-ide-extension.detectTests",
          "when": "view == cloudIdeWebview",
          "group": "navigation@1"
        },
        {
          "command": "cloud-ide-extension.runAllTests", 
          "when": "view == cloudIdeWebview",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "cloud-ide-extension.detectTests",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "cloud-ide-extension.runAllTests",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "cloud-ide-extension.runSingleTest",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}